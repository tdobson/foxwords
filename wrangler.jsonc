{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foxwords",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ENV": "local",
    "SES_REGION": "eu-west-2",
    "APP_ORIGIN": "http://localhost:8787"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "foxwords-dev",
      "database_id": "faba9733-aea9-4f7e-930b-669c113f01b7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "foxwords-media"
    }
  ],
  "env": {
    "dev": {
      "name": "foxwords-dev-worker",
      "vars": {
        "APP_ENV": "dev",
        "SES_REGION": "eu-west-2",
        "APP_ORIGIN": "https://foxwords-dev.tdobson.net"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "foxwords-dev",
          "database_id": "faba9733-aea9-4f7e-930b-669c113f01b7"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "foxwords-media"
        }
      ]
    },
    "production": {
      "name": "foxwords",
      "routes": [
        { "pattern": "game.tdobson.net", "custom_domain": true },
        { "pattern": "james-game.tdobson.net", "custom_domain": true }
      ],
      "vars": {
        "APP_ENV": "production",
        "SES_REGION": "eu-west-2",
        "APP_ORIGIN": "https://game.tdobson.net"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "foxwords-prod",
          "database_id": "0186a8b9-8da5-46e6-863d-7da3eedaad24"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "foxwords-media"
        }
      ]
    }
  }
}
