{
  "name": "foxwords",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:worker": "scripts/low-priority.sh opennextjs-cloudflare build && scripts/low-priority.sh wrangler dev",
    "build": "scripts/low-priority.sh opennextjs-cloudflare build",
    "bundle": "scripts/low-priority.sh next build && node scripts/create-bundle.mjs",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "typecheck": "scripts/low-priority.sh tsc --noEmit",
    "lint": "scripts/low-priority.sh biome check . && scripts/low-priority.sh stylelint '**/*.css' --cache",
    "jest": "scripts/low-priority.sh jest --runInBand",
    "jest:watch": "jest --watch",
    "e2e": "scripts/low-priority.sh playwright test",
    "format:test": "scripts/low-priority.sh biome format .",
    "format:write": "scripts/low-priority.sh biome format --write .",
    "test": "yarn format:test && yarn lint && yarn typecheck && yarn jest",
    "preview": "scripts/low-priority.sh opennextjs-cloudflare build && scripts/low-priority.sh wrangler dev",
    "deploy:dev": "scripts/low-priority.sh opennextjs-cloudflare build && scripts/low-priority.sh wrangler deploy --env dev",
    "deploy:prod": "scripts/low-priority.sh opennextjs-cloudflare build && scripts/low-priority.sh wrangler deploy --env production"
  },
  "dependencies": {
    "@mantine/core": "9.4.0",
    "@mantine/hooks": "9.4.0",
    "@next/bundle-analyzer": "^16.0.0",
    "@tabler/icons-react": "^3.35.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@opennextjs/cloudflare": "1.20.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "@types/react": "19.2.17",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-jest": "^29.4.4",
    "typescript": "6.0.3",
    "wrangler": "^4.131.1"
  },
  "packageManager": "yarn@4.17.0"
}
